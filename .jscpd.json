{
  "threshold": 0,
  "minLines": 5,
  "minTokens": 50,
  "ignoreIdentifiers": true,
  "failOnEmpty": true,
  "reporters": ["json", "console"],
  "output": "reports/jscpd",
  "ignore": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "types/supabase.ts",
    "components/ui/**"
  ],
  "ignorePattern": ["(?m)^import[^;]*;"],
  "absolute": true
}
