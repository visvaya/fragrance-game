{
  "minLines": 5,
  "minTokens": 50,
  "reporters": ["json", "console"],
  "output": "reports/jscpd",
  "ignore": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/lib/validations/supabase.schema.ts"
  ],
  "ignorePattern": ["(?<=^|\\n)import[ \\t{*][^;]*;"],
  "absolute": true
}
