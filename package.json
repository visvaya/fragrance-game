{
  "name": "eauxle",
  "version": "0.9.0",
  "private": true,
  "description": "A daily puzzle for perfume lovers inspired by Wordle. Guess the mystery perfume from evolving clues like bottle, notes, brand, and year.",
  "keywords": [
    "fragrance",
    "fragrances",
    "wordle"
  ],
  "author": "visvaya",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.21.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/visvaya/fragrance-game.git"
  },
  "homepage": "https://eauxle.vercel.app",
  "bugs": {
    "url": "https://github.com/visvaya/fragrance-game/issues"
  },
  "engines": {
    "node": "^26.13.1"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "build": "next build",
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "lint": "pnpm lint:strict",
    "lint:strict": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:dev": "vitest",
    "test:e2e": "cross-env NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA playwright test",
    "test:a11y": "cross-env NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA playwright test e2e/a11y",
    "test:load": "pnpm dlx artillery@2.0.34 run scripts/load-test.yaml",
    "test:perf": "cross-env NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA playwright test e2e/performance",
    "audit:lighthouse": "tsx scripts/parse-lighthouse.ts ./reports/latest.report.json",
    "clean": "pnpm exec rimraf .next node_modules",
    "supabase": "supabase",
    "supabase:start": "pnpm supabase start",
    "supabase:stop": "pnpm supabase stop",
    "supabase:reset": "pnpm supabase db reset",
    "supabase:types": "tsx scripts/gen-supabase-types.ts",
    "supabase:advisors": "node scripts/check-advisors.mjs",
    "supabase:db-lint": "pnpm supabase db lint --remote",
    "test:db": "pnpm supabase test db",
    "db:fingerprint": "supabase db query --agent=no --yes -f supabase/schema-fingerprint.sql --output json --remote | tsx scripts/db-fingerprint.ts",
    "lint:duplicates": "jscpd . --pattern \"{*.ts,{app,lib,components,hooks,scripts,i18n,lint,types}/**/*.{ts,tsx,mjs,css}}\" && jscpd scripts --format python && jscpd . --pattern \"{*.ts,{lib,hooks,scripts,i18n,lint,types,app/actions,app/api}/**/*.{ts,mjs}}\" --min-tokens 40 --min-lines 4",
    "budget:startup-js": "next analyze --experimental-app-only -o && tsx scripts/check-startup-js.ts",
    "lint:typed-files": "tsx scripts/check-typed-files.ts",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.6",
    "@marsidev/react-turnstile": "1.6.3",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@sentry/nextjs": "11.12.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@upstash/ratelimit": "2.2.1",
    "@upstash/redis": "1.41.0",
    "@vercel/speed-insights": "2.1.0",
    "bowser": "2.15.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lenis": "1.3.27",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "next-themes": "0.4.6",
    "posthog-js": "1.450.0",
    "posthog-node": "5.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "web-haptics": "0.0.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@next/bundle-analyzer": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-fp": "2.3.0",
    "eslint-plugin-jsdoc": "65.4.8",
    "eslint-plugin-perfectionist": "5.14.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-react-web-api": "5.30.3",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "9.1.7",
    "jscpd": "5.4.3",
    "jsdom": "31.0.1",
    "knip": "6.45.1",
    "lint-staged": "17.6.1",
    "markdownlint-cli2": "0.24.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "playwright-core": "1.65.1",
    "postcss": "8.5.33",
    "rimraf": "6.1.4",
    "squawk-cli": "2.73.0",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=10.0.0 <10.2.1": ">=10.2.1",
