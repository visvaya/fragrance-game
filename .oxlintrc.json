            "message": "Use rem instead of px in Tailwind arbitrary values. Example: text-[0.625rem] instead of text-[10px]. Exceptions: border (1px, 2px) and border-radius (999px): add eslint-disable with a comment."
          },
          {
            "selector": "JSXAttribute[name.name='className'] TemplateLiteral > TemplateElement[value.raw=/\\[\\d+(?:\\.\\d+)?px\\]/]",
            "message": "Use rem instead of px in Tailwind arbitrary values."
          },
          {
            "selector": "JSXAttribute[name.name='style'] ObjectExpression > Property > Literal[value=/^\\d+(?:\\.\\d+)?px$/]",
            "message": "Use rem instead of px in inline styles. 1rem = 16px. Exceptions: border (1px): add eslint-disable with a comment."
