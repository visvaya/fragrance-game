          "error",
          {
            "allowedStrings": [
              ":",
              "/",
              "%",
              "(",
              ")",
              "?",
              "...",
              "\u2014",
              "\u2605",
              "Eauxle"
            ]
          }
        ],
        "eauxle/ui-text": [
          "error",
          {
            "selector": "JSXAttribute[name.name=/^(aria-label|aria-description|title|alt|description|label|content|heading)$/] > Literal[value=/[A-Za-z]/]",
            "message": "UI text goes through next-intl: add the key to messages/en.json and messages/pl.json and use t(...)."
          },
          {
            // next/image takes a technical placeholder="blur" (a mode, not text), so only Image is exempt here.
            "selector": "JSXOpeningElement[name.name!='Image'] > JSXAttribute[name.name='placeholder'] > Literal[value=/[A-Za-z]/]",
            "message": "UI text goes through next-intl: add the key to messages/en.json and messages/pl.json and use t(...)."
          },
          {
            "selector": "CallExpression[callee.name='toast'][arguments.0.type='Literal'], CallExpression[callee.object.name='toast'][callee.property.name=/^(success|error|info|warning)$/][arguments.0.type='Literal']",
