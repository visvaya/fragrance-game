# =============================================================================
# Eauxle — environment variables
# Copy to .env.local and fill in real values. .env.local is git-ignored.
#
# REQUIRED  — validated by lib/env.ts (Zod). App fails to start without them.
# OPTIONAL  — validated when present, safe to omit.
# TOOLING   — not read by the app; used by scripts, tests or the CI pipeline.
# =============================================================================

# --- Supabase — REQUIRED -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL='-'
NEXT_PUBLIC_SUPABASE_ANON_KEY='-'
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY='-'

# --- Rate limiting (Upstash Redis) — REQUIRED --------------------------------
UPSTASH_REDIS_REST_URL='-'
UPSTASH_REDIS_REST_TOKEN='-'

# --- Cron — REQUIRED ---------------------------------------------------------
# Shared secret for /api/cron/generate-daily. Vercel Cron sends it as a Bearer token.
CRON_SECRET='-'

# --- Analytics (PostHog) — REQUIRED ------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY='-'
# OPTIONAL — reverse-proxy host for ingestion and the toolbar.
NEXT_PUBLIC_POSTHOG_HOST='-'
NEXT_PUBLIC_POSTHOG_UI_HOST='-'

# --- Assets (Cloudflare R2 public host) — OPTIONAL ---------------------------
# Public CDN hostname for perfume images. Also whitelisted in next.config.mjs.
NEXT_PUBLIC_ASSETS_HOST='-'

# --- Captcha (Cloudflare Turnstile) — OPTIONAL -------------------------------
# Client-side widget key. Playwright uses the always-passing test key instead.
NEXT_PUBLIC_TURNSTILE_SITE_KEY='-'

# --- CORS — OPTIONAL ---------------------------------------------------------
# Comma-separated origin allowlist enforced in proxy.ts. Defaults to same-origin.
ALLOWED_ORIGINS='-'

# --- Feature flags — OPTIONAL ------------------------------------------------
# Shows the in-game reset button. Keep 'false' in production.
NEXT_PUBLIC_GAME_RESET_ENABLED='false'

# --- Error tracking (Sentry) — OPTIONAL --------------------------------------
NEXT_PUBLIC_SENTRY_DSN='-'
# TOOLING — read by next.config.mjs at build time for source-map upload.
SENTRY_ORG='-'
SENTRY_PROJECT='-'
SENTRY_AUTH_TOKEN='-'

# --- TOOLING — local scripts -------------------------------------------------
# pnpm supabase:types — target project for type generation.
# Also the project ref checked by `pnpm supabase:advisors`.
SUPABASE_PROJECT_ID='-'
# Personal access token (database:read) for the Supabase Management API —
# used by `pnpm supabase:advisors` and `supabase link` in CI.
SUPABASE_ACCESS_TOKEN='-'
# scripts/apply_migration_m5.py — direct Postgres connection.
SUPABASE_DB_PASSWORD='-'
# scripts/etl_v5.py — image pipeline upload credentials.
R2_ACCESS_KEY_ID='-'
R2_SECRET_ACCESS_KEY='-'
R2_BUCKET_NAME='-'
R2_ENDPOINT_URL='-'

# --- TOOLING — tests ---------------------------------------------------------
# Password for the seeded Playwright account (e2e/auth/auth.spec.ts).
E2E_TEST_PASSWORD='-'
# Opt-in flag for integration tests that hit a live Supabase instance.
VITEST_INTEGRATION='false'
# Disposable staging project for algorithm.integration.test.ts — IT TRUNCATES TABLES.
# Never point these at production.
TEST_SUPABASE_URL='-'
TEST_SUPABASE_SERVICE_ROLE_KEY='-'

# --- TOOLING — build ---------------------------------------------------------
# Set to 1 to skip lib/env.ts validation (builds without a full env, e.g. in CI).
SKIP_ENV_VALIDATION='0'
# Set to 'true' to emit a bundle-analyzer report during `pnpm build`.
ANALYZE='false'

# --- Configured outside this file --------------------------------------------
# TURNSTILE_SECRET_KEY — lives in the Supabase Dashboard (Auth > Attack Protection),
#   not in the app. Supabase verifies the captcha server-side during signInAnonymously().
